      "name": "Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SET_ME_supabase",
          "name": "Supabase service key (Lingo)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "Quiet N h · inside 24 h · sending hours",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Follow-ups (texts filled in and saved by bot_due_followups): one WhatsApp message each, sent with\n// that seller's own token. \"No order yet\" gets a 🛒 Order button.\nconst cfg = $('Config').first().json;\nconst res = $input.first().json || {};\nconst items = [];\nfor (const it of res.items || []) {\n  if (!it.text || !it.token || !it.phone_number_id) continue;\n  const base = { messaging_product: 'whatsapp', recipient_type: 'individual', to: String(it.to) };\n  const body = it.kind === 'notify_no_order'\n    ? { ...base, type: 'interactive', interactive: { type: 'button', body: { text: Array.from(it.text).slice(0, 1024).join('') },\n        action: { buttons: [{ type: 'reply', reply: { id: 'ORDER', title: Array.from(it.button || 'Order').slice(0, 20).join('') } }] } } }\n    : { ...base, type: 'text', text: { body: it.text, preview_url: false } };\n  items.push({ json: { msg_id: it.msg_id, auth: 'Bearer ' + it.token, url: `https://graph.facebook.com/${cfg.GRAPH_VERSION}/${it.phone_number_id}/messages`, body } });\n}\nreturn items;\n"
      },
      "id": "a0542d7c-3286-4005-9d17-6f9f4c077cfd",
      "name": "Build Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.auth }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "id": "bb05eac5-2d96-4f60-9f8d-d2553543d772",
      "name": "Send Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp message ids of the follow-ups just sent → saved with each message (for delivery statuses).\nconst sent = $('Build Follow-ups').all();\nconst items = $input.all().map((r, i) => {\n  const j = r.json || {};\n  const id = ((j.messages || [])[0] || {}).id || null;\n  const e = j.error ? (typeof j.error === 'string' ? j.error : `${j.error.code || ''} ${j.error.message || ''}`.trim()) : null;\n  return { msg_id: sent[i] ? sent[i].json.msg_id : null, wa_id: id, error: e || (id ? null : 'no message id') };\n}).filter(x => x.msg_id);\nreturn [{ json: { p: { items } } }];\n"
      },
      "id": "6fa8d5a5-0762-4a4b-81c3-b0615d4cb093",
      "name": "Collect Ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ]
    },
