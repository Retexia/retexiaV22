      "id": "e66d8c71-cb98-4c59-86eb-fbe617e5c8b9",
      "name": "WA: Number Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        480
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Health answer per number → bot_save_check (problems show as a banner in the seller's Lingo and in admin).\nconst asked = $('Split Numbers').all();\nreturn $input.all().map((r, i) => {\n  const j = r.json || {};\n  const b = j.body !== undefined ? j.body : j;\n  const e = (b && b.error) || null;\n  const err = e ? `${e.code ? '(' + e.code + ') ' : ''}${e.error_user_msg || e.message || 'error'}`.slice(0, 300) : null;\n  return { json: { p: {\n    phone_number_id: asked[i] ? asked[i].json.phone_number_id : null,\n    ok: !err && !!(b && b.id),\n    error: err || (b && b.id ? null : 'WhatsApp did not answer'),\n    info: err ? {} : { display_phone_number: b.display_phone_number || '', verified_name: b.verified_name || '', quality_rating: b.quality_rating || '',\n                        code_verification_status: b.code_verification_status || '', name_status: b.name_status || '' },\n  } } };\n}).filter(x => x.json.p.phone_number_id);\n"
      },
      "id": "ea7ef400-1c54-47af-baee-84a445827008",
      "name": "Health Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
