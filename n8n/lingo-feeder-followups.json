    {
      "parameters": {
        "jsCode": "// Every connected WhatsApp number → one health check each (token valid, number status, quality rating).\nconst cfg = $('Config').first().json;\nconst list = Array.isArray($input.first().json) ? $input.first().json : ($input.first().json || {}).items || $input.all().map(i => i.json);\nreturn (list || []).filter(n => n && n.token && n.phone_number_id).map(n => ({ json: {\n  phone_number_id: n.phone_number_id,\n  auth: 'Bearer ' + n.token,\n  url: `https://graph.facebook.com/${cfg.GRAPH_VERSION}/${n.phone_number_id}`,\n  qs: { fields: 'display_phone_number,verified_name,quality_rating,code_verification_status,name_status,platform_type' },\n} }));\n"
      },
      "id": "b4541c72-0124-48e8-ba31-5758485b89a9",
      "name": "Split Numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        480
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 200
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.auth }}"
            }
          ]
        },
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={{ JSON.stringify($json.qs) }}"
      },
      "id": "52a62ddf-24c6-41d4-9b30-950cef7f6cc3",
      "name": "WA: Number Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        480
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Health answer per number → bot_save_check (problems show as a banner in the seller's Lingo Feeder and in admin).\nconst asked = $('Split Numbers').all();\nreturn $input.all().map((r, i) => {\n  const j = r.json || {};\n  const b = j.body !== undefined ? j.body : j;\n  const e = (b && b.error) || null;\n  const err = e ? `${e.code ? '(' + e.code + ') ' : ''}${e.error_user_msg || e.message || 'error'}`.slice(0, 300) : null;\n  return { json: { p: {\n    phone_number_id: asked[i] ? asked[i].json.phone_number_id : null,\n    ok: !err && !!(b && b.id),\n    error: err || (b && b.id ? null : 'WhatsApp did not answer'),\n    info: err ? {} : { display_phone_number: b.display_phone_number || '', verified_name: b.verified_name || '', quality_rating: b.quality_rating || '',\n                        code_verification_status: b.code_verification_status || '', name_status: b.name_status || '' },\n  } } };\n}).filter(x => x.json.p.phone_number_id);\n"
      },
      "id": "62359daa-83dc-445c-ab4e-584aa6b015b0",
      "name": "Health Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        480
      ]
    },
