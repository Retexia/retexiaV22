        "jsonBody": "={{ JSON.stringify({ p: { limit: 100 } }) }}"
      },
      "id": "3d157125-96ac-4eb1-b592-97bbe2b38ecd",
      "name": "Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SET_ME_supabase",
          "name": "Supabase service key (Lingo Feeder)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "Statuses · one follow-up · inside 24 h",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Follow-ups (texts filled in and saved by bot_due_followups): one WhatsApp message each with a\n// 🛒 Order button, sent with that seller's own token.\nconst cfg = $('Config').first().json;\nconst res = $input.first().json || {};\nconst items = [];\nfor (const it of res.items || []) {\n  if (!it.text || !it.token || !it.phone_number_id) continue;\n  const body = { messaging_product: 'whatsapp', recipient_type: 'individual', to: String(it.to), type: 'interactive',\n    interactive: { type: 'button', body: { text: Array.from(it.text).slice(0, 1024).join('') },\n      action: { buttons: [{ type: 'reply', reply: { id: 'ORDER', title: Array.from(it.button || 'Order').slice(0, 20).join('') } }] } } };\n  items.push({ json: { msg_id: it.msg_id, auth: 'Bearer ' + it.token, url: `https://graph.facebook.com/${cfg.GRAPH_VERSION}/${it.phone_number_id}/messages`, body } });\n}\nreturn items;\n"
      },
      "id": "7708eac7-de98-4ed0-863d-9a9de469d464",
      "name": "Build Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 300
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.auth }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}"
      },
      "id": "d8a19f4c-f6ce-4984-95dd-8b7dd29a614a",
      "name": "Send Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// WhatsApp message ids of the follow-ups just sent → saved with each message (for delivery statuses).\nconst sent = $('Build Follow-ups').all();\nconst items = $input.all().map((r, i) => {\n  const j = r.json || {};\n  const id = ((j.messages || [])[0] || {}).id || null;\n  const e = j.error ? (typeof j.error === 'string' ? j.error : `${j.error.code || ''} ${j.error.message || ''}`.trim()) : null;\n  return { msg_id: sent[i] ? sent[i].json.msg_id : null, wa_id: id, error: e || (id ? null : 'no message id') };\n}).filter(x => x.msg_id);\nreturn [{ json: { p: { items } } }];\n"
      },
      "id": "2a488b2a-f526-429f-81f9-c0ee56f83a03",
      "name": "Collect Ids",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.SUPABASE_URL }}/rest/v1/rpc/bot_set_wa_ids",
        "options": {
