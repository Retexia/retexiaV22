            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p: $json.p }) }}"
      },
      "id": "adf7867d-62d8-40e7-9b58-77e4e44580c1",
      "name": "Save Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        480
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SET_ME_supabase",
