      "id": "55a964ae-a111-460f-9c49-98c24adf2fc9",
      "name": "Numbers To Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        480
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SET_ME_supabase",
          "name": "Supabase service key (Lingo Feeder)"
        }
      },
