# Copy to apps/web/.env.local for local development, and set the same values
# in Vercel (Project → Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://axommwxevnfpljroejmc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImF4b21td3hldm5mcGxqcm9lam1jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEzMjMwMTEsImV4cCI6MjEwNjg5OTAxMX0.G0I4vSfrSwyrFlani_pPxQ2915ywWdwbDCIA2ALB-xY
# The public address of this site, no trailing slash
NEXT_PUBLIC_SITE_URL=https://retexia.com
# .retexia.com in production so one login works on every *.retexia.com app.
# Leave empty on localhost and Vercel preview URLs.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Any long random string. Supabase Database Webhooks send it to /api/revalidate.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Paddle (payments): sandbox while testing, production for live (then live_ token + live API key).
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → Client-side tokens (public, starts with test_ or live_).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Paddle → Developer tools → Authentication → API keys (server-only; creates checkouts and billing-portal links).
PADDLE_API_KEY=

# PayHere (online payments). payhere (default) or paddle.
PAYMENT_PROVIDER=payhere
# true while testing on sandbox.payhere.lk; false for live payments.
NEXT_PUBLIC_PAYHERE_SANDBOX=true
# PayHere → Integrations: Merchant ID, and the Merchant Secret of the domain www.retexia.com.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# PayHere → Settings → API keys (App ID + App Secret): cancelling subscriptions, checking payments.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
