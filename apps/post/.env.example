# apps/post (post.retexia.com). Copy to apps/post/.env.local for local development.

# Main Retexia project (same as the website): sign-in and the customer's orders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Retexia Post project (the second database). Server-side only, never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL2=
SUPABASE_SERVICE_ROLE_KEY2=

NEXT_PUBLIC_SITE_URL=https://post.retexia.com
NEXT_PUBLIC_WEB_URL=https://retexia.com
NEXT_PUBLIC_COOKIE_DOMAIN=.retexia.com      # empty on localhost

# n8n "Retexia — Photo post (generate + publish)" webhook, and a shared key sent as X-Retexia-Key.
N8N_PHOTO_POST_URL=https://n8n.example.com/webhook/retexia-photo-post
N8N_POST_KEY=
