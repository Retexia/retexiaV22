# apps/panels: product panels on their own subdomains (post.retexia.com, lingo.retexia.com).
# Copy to apps/panels/.env.local for local development. In Vercel: Project → Settings → Environment Variables.

# The Retexia Supabase project (website, admin, Post and Lingo all live in it).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-side only; reads the post and lingo schemas
NEXT_PUBLIC_WEB_URL=https://www.retexia.com
NEXT_PUBLIC_COOKIE_DOMAIN=.retexia.com      # empty on localhost

# --- Lingo: customers link their WhatsApp themselves (QR code) ---------------
# Retexia's Evolution API server and its global API key (Evolution → AUTHENTICATION_API_KEY).
EVOLUTION_API_URL=https://evo.example.com
EVOLUTION_API_KEY=
# n8n "Lingo · WhatsApp AI Bot" → WhatsApp Webhook node → Production URL (…/webhook/Lingo).
LINGO_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/Lingo

# --- Post: the n8n worker -----------------------------------------------------
# n8n workflow "Retexia — Post (worker)" (n8n/retexia-post.json): Production URL of its webhook.
# N8N_POST_KEY must equal retexiaKey in the workflow's Config node (sent as X-Retexia-Key).
N8N_POST_URL=https://n8n.example.com/webhook/retexia-post
N8N_POST_KEY=
# Post: this app decides what happens and when; the n8n workflow is the worker (plan, design,
# publish, delete, edit_text, whatsapp). Customers' Facebook/Instagram tokens live in Supabase
# (post.admin_connect_page, migration 0016): no Meta keys are needed here.
# POST_PUBLISHER=panel only makes this app talk to Meta/WhatsApp itself (fallback).
POST_PUBLISHER=n8n
# Fallback only (POST_PUBLISHER=panel): Retexia's WhatsApp instance on EVOLUTION_API_URL.
POST_WHATSAPP_INSTANCE=
POST_WHATSAPP_KEY=
POST_PANEL_URL=https://post.retexia.com

# --- Post: "Connect Facebook & Instagram" (Meta app) -----------------------------
# The Connect button shows when META_APP_ID is set and either META_APP_SECRET is set here
# (this app exchanges the code) or N8N_POST_URL is set (the n8n worker exchanges it, with the
# secret in its Config node: keep META_APP_SECRET empty here then).
# developers.facebook.com → your app → App settings → Basic. Valid OAuth redirect URI:
# https://post.retexia.com/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Optional: the permissions to ask for (comma-separated). Only list permissions added to the app.
# Default: pages_show_list,pages_manage_posts,pages_read_engagement,pages_manage_metadata,
# pages_messaging,instagram_basic,instagram_content_publish,instagram_manage_comments,
# instagram_manage_messages,business_management
META_SCOPES=
# true once the Meta app offers instagram_manage_contents (deleting Instagram posts from the panel).
# Leave it off until then: Facebook Login fails when it asks for a permission the app doesn't have.
META_INSTAGRAM_DELETE=false

# --- Post: scheduler key ----------------------------------------------------
# Supabase calls /api/post/publish (only when a post is due) and /api/post/batch (planning
# and designs) with this key (Vault secret post_cron_key). At least 32 random characters.
POST_CRON_KEY=

# Local development only: which panel localhost shows (post or lingo).
PANEL_DEFAULT=post

# Retexia Feeder (feeder.retexia.com): one panel, every package in the menu, the
# customer's own packages open, the rest locked. Product slug in the products table.
FEEDER_PRODUCT_SLUG=feeder
# n8n "FB Leads → Courier CSV" (n8n/feeder-bulk-import.json) → Panel: Bulk import → Production URL.
FEEDER_N8N_URL=
# Same value as KEY in its "Check panel key" node (sent as X-Retexia-Key).
FEEDER_N8N_KEY=
