# apps/admin (admin.retexia.com). Copy to apps/admin/.env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # admin app only, server-side. Never in apps/web.
NEXT_PUBLIC_ADMIN_URL=https://admin.retexia.com
NEXT_PUBLIC_WEB_URL=https://retexia.com
NEXT_PUBLIC_COOKIE_DOMAIN=.retexia.com   # empty on localhost
REVALIDATE_SECRET=                   # same value as apps/web

# Customer emails (status changes, payments) sent through Resend from the admin.
# API key from the Resend team where retexia.com is verified.
RESEND_API_KEY=
EMAIL_FROM="Retexia <admin@retexia.com>"
EMAIL_REPLY_TO=
# Shared secret for the Supabase Database Webhook that calls /api/notifications/dispatch
OUTBOX_WEBHOOK_SECRET=

# n8n "Lingo · WhatsApp AI Bot" → WhatsApp Webhook → Production URL (…/webhook/Lingo).
# Used by "Link to n8n bot" on a Lingo bot account in the admin.
LINGO_N8N_WEBHOOK_URL=

# Paddle (payments): sandbox while testing, production for live (live API key + live destination's secret).
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle → Developer tools → Authentication → API keys (server-only).
PADDLE_API_KEY=
# Paddle → Developer tools → Notifications → your destination's secret key.
PADDLE_WEBHOOK_SECRET=

# PayHere (online payments). payhere (default) or paddle.
PAYMENT_PROVIDER=payhere
# true while testing on sandbox.payhere.lk; false for live payments.
NEXT_PUBLIC_PAYHERE_SANDBOX=true
# PayHere → Integrations: Merchant ID, and the Merchant Secret of the domain www.retexia.com.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# PayHere → Settings → API keys (App ID + App Secret): cancelling subscriptions, checking payments.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
