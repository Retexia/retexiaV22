{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_COOKIE_DOMAIN",
    "REVALIDATE_SECRET",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_WEB_URL",
    "N8N_PHOTO_POST_URL",
    "N8N_POST_KEY",
    "POST_PRODUCT_SLUG",
    "POST_SAFETY_WORKFLOW",
    "LINGO_PRODUCT_SLUG",
    "PANEL_DEFAULT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "lint": {},
    "typecheck": {}
  }
}
