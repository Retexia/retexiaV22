{
  "name": "retexia",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:test": "node scripts/test-db.mjs && node scripts/test-admin-db.mjs && node scripts/test-products-db.mjs",
    "db:types": "node scripts/gen-types.mjs",
    "db:types:supabase": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:mock": "node scripts/e2e/mock-supabase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3"
  }
}
